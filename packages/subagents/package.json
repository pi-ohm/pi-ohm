{
  "name": "@pi-ohm/subagents",
  "version": "0.6.4",
  "homepage": "https://github.com/pi-ohm/pi-ohm/tree/dev/packages/subagents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-ohm/pi-ohm.git",
    "directory": "packages/subagents"
  },
  "files": [
    "dist/",
    "src/runtime/backend/prompts/",
    "README.md"
  ],
  "type": "module",
