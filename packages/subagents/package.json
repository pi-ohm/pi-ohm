    "@pi-ohm/tui": "workspace:*",
    "better-result": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.74.0",
    "@earendil-works/pi-tui": "0.74.0",
