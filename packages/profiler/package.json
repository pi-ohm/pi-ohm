{
  "name": "@pi-ohm/profiler",
  "version": "0.6.4",
  "homepage": "https://github.com/pi-ohm/pi-ohm/tree/dev/packages/profiler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-ohm/pi-ohm.git",
    "directory": "packages/profiler"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "type": "module",
  "main": "dist/extension.js",
  "types": "dist/extension.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark.d.ts",
      "default": "./dist/benchmark.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack src/extension.ts src/benchmark.ts src/cli.ts src/config.ts src/report.ts src/store.ts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "catalog:pi",
    "@pi-ohm/core": "workspace:*",
    "better-result": "catalog:",
    "typebox": "^1.0.68"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.79.4"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  }
}
