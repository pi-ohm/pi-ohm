{
  "name": "@pi-ohm/core",
  "version": "0.6.4",
  "homepage": "https://github.com/pi-ohm/pi-ohm/tree/dev/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-ohm/pi-ohm.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./grammar": {
      "types": "./dist/grammar.d.ts",
      "default": "./dist/grammar.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./toolkit": {
      "types": "./dist/toolkit.d.ts",
      "default": "./dist/toolkit.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./config/features": {
      "types": "./dist/config/features.d.ts",
      "default": "./dist/config/features.js"
    },
    "./config/modes": {
      "types": "./dist/config/modes.d.ts",
      "default": "./dist/config/modes.js"
    },
    "./config/painter": {
      "types": "./dist/config/painter.d.ts",
      "default": "./dist/config/painter.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "default": "./dist/events/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack src/errors.ts src/grammar.ts src/paths.ts src/toolkit.ts src/db/index.ts src/config/index.ts src/config/features.ts src/config/modes.ts src/config/painter.ts src/events/index.ts"
  },
  "dependencies": {
    "@libsql/client": "catalog:",
    "better-result": "catalog:",
    "typebox": "^1.0.68"
  }
}
