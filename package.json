{
  "name": "pi-ohm-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Pi Ohm monorepo: focused Amp-inspired workflows for Pi",
  "keywords": [
    "handoff",
    "imagegen",
    "memories",
    "ohm",
    "pi",
    "pi-coding-agent",
    "pi-ohm",
    "pi-package",
    "subagents",
    "thread-search"
  ],
  "homepage": "https://github.com/pi-ohm/pi-ohm/tree/dev#readme",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "docs/"
  ],
  "files": [
    "extensions/",
    "packages/",
    "src_legacy/",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "type": "module",
  "scripts": {
    "build": "for p in packages/config packages/core packages/db packages/handoff packages/memories packages/modes packages/painter packages/session-search packages/subagents packages/tui packages/extension; do (cd \"$p\" && vp run build); done",
    "build:docs": "yarn workspace docs build",
    "dev:docs": "yarn workspace docs dev",
    "build:watch": "for p in packages/config packages/core packages/db packages/handoff packages/memories packages/modes packages/painter packages/session-search packages/subagents packages/tui packages/extension; do (cd \"$p\" && vp run build -- --watch) & done; wait",
    "release:dev": "node --experimental-strip-types ./scripts/publish-packages.ts --channel dev",
    "release:latest": "node --experimental-strip-types ./scripts/publish-packages.ts --channel latest",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test:db": "tsx --test \"packages/db/src/**/*.test.ts\"",
    "test:subagents": "tsx --test \"packages/subagents/src/**/*.test.ts\"",
    "test:subagents:dist": "yarn build && tsx --test \"packages/subagents/tests-dist/**/*.test.ts\"",
    "test:subagents:golden": "tsx --test packages/subagents/src/runtime/backend/tests/system-prompt-harness.test.ts",
    "test:subagents:golden:update": "UPDATE_PROMPTS=1 yarn test:subagents:golden",
    "test": "vp test",
    "oxlint": "vp lint . --tsconfig tsconfig.json --type-aware --ignore-pattern \"**/dist/**\"",
    "lint": "vp lint . --tsconfig tsconfig.json --type-aware --ignore-pattern \"**/dist/**\"",
    "lint:fix": "vp lint . --tsconfig tsconfig.json --type-aware --ignore-pattern \"**/dist/**\" --fix",
    "oxfmt": "vp fmt . --write",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "hooks:install": "lefthook install",
    "postinstall": "sh -c 'if [ -d .git ]; then lefthook install; fi'",
    "test:memories": "tsx --test \"packages/memories/src/**/*.test.ts\""
  },
  "dependencies": {
    "@juanibiapina/pi-extension-settings": "^0.6.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "catalog:pi",
    "@mariozechner/pi-tui": "catalog:pi",
    "@types/node": "^24.3.1",
    "@typescript/native-preview": "^7.0.0-dev.20260217.1",
    "lefthook": "^2.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  },
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "yarn@4.12.0",
  "pi": {
    "extensions": [
      "./node_modules/@juanibiapina/pi-extension-settings/dist/index.js",
      "./extensions"
    ]
  }
}
