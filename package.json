{
  "name": "pi-ohm-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Pi Ohm monorepo: focused Amp-inspired workflows for Pi",
  "keywords": [
    "handoff",
    "imagegen",
    "memories",
    "ohm",
    "pi",
    "pi-coding-agent",
    "pi-ohm",
    "pi-package",
    "subagents",
    "thread-search"
  ],
  "homepage": "https://github.com/pi-ohm/pi-ohm/tree/dev#readme",
  "license": "MIT",
  "files": [
    "extensions/",
    "packages/",
    "src_legacy/",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/*' --if-present run build",
    "build:docs": "pnpm --filter docs run build",
    "dev:docs": "pnpm --filter docs run dev",
    "build:watch": "pnpm --parallel --filter './packages/*' --if-present run build -- --watch",
    "release:dev": "node --experimental-strip-types ./scripts/publish-packages.ts --channel dev",
    "release:latest": "node --experimental-strip-types ./scripts/publish-packages.ts --channel latest",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test:subagents": "pnpm --filter @pi-ohm/subagents exec tsx --test \"src/**/*.test.ts\"",
    "test:subagents:dist": "pnpm build && pnpm --filter @pi-ohm/subagents exec tsx --test \"tests-dist/**/*.test.ts\"",
    "test:subagents:golden": "pnpm --filter @pi-ohm/subagents exec tsx --test src/runtime/backend/tests/system-prompt-harness.test.ts",
    "test:subagents:golden:update": "UPDATE_PROMPTS=1 pnpm test:subagents:golden",
    "test": "vp test",
    "oxlint": "vp lint . --tsconfig tsconfig.json --type-aware --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/src_legacy/**\"",
    "lint": "vp lint . --tsconfig tsconfig.json --type-aware --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/src_legacy/**\"",
    "lint:fix": "vp lint . --tsconfig tsconfig.json --type-aware --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/src_legacy/**\" --fix",
    "oxfmt": "vp fmt . --write",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "hooks:install": "lefthook install",
    "postinstall": "sh -c 'if [ -d .git ]; then lefthook install; fi'",
    "test:memories": "pnpm --filter @pi-ohm/memories exec tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@typescript/native-preview": "^7.0.0-dev.20260217.1",
    "drizzle-kit": "catalog:",
    "lefthook": "^2.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.25.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "esbuild",
      "koffi",
      "lefthook",
      "protobufjs",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
